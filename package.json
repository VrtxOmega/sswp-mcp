{
  "name": "sswp-mcp",
  "version": "2.1.0",
  "description": "Task-scoped software evidence with explicit gate results and versioned local integrity records.",
  "type": "commonjs",
  "main": "dist/sswp.cjs",
  "bin": {
    "sswp-mcp": "dist/sswp.cjs"
  },
  "scripts": {
    "start": "node dist/sswp.cjs",
    "cli": "node dist/sswp-cli.cjs",
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs"
  },
  "keywords": [
    "mcp",
    "ai",
    "veritas",
    "attestation",
    "witness",
    "deterministic-build",
    "sswp"
  ],
  "author": "RJ <rj@veritas.engineering>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "better-sqlite3": "^12.9.0",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.19.0"
}
